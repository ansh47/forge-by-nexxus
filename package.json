{
  "name": "forge-by-nexxus",
  "version": "0.4.2",
  "description": "Scaffolds React, Spring Boot and Python projects that build before you touch them. Versions and structure are decided, and add-ons you decline leave nothing behind.",
  "license": "MIT",
  "author": "Ankit Shrivastava",
  "keywords": [
    "cli",
    "scaffold",
    "generator",
    "boilerplate",
    "template",
    "spring-boot",
    "react",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ansh47/forge-by-nexxus.git"
  },
  "homepage": "https://github.com/ansh47/forge-by-nexxus#readme",
  "bugs": {
    "url": "https://github.com/ansh47/forge-by-nexxus/issues"
  },
  "type": "module",
  "bin": {
    "forge": "dist/index.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && shx chmod +x dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "node --import tsx --test src/*.test.ts",
    "lint:templates": "npm run build && node dist/index.js lint",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@clack/prompts": "^0.8.2",
    "commander": "^12.1.0",
    "fs-extra": "^11.2.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.10.2",
    "shx": "^0.3.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
