{
  "name": "forge-by-nexxus",
  "version": "0.1.0",
  "description": "A personal, extensible project scaffold generator. Spins up new projects from your own templates.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "forge": "./dist/index.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && shx chmod +x dist/index.js",
    "dev": "tsx src/index.ts",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@clack/prompts": "^0.8.2",
    "commander": "^12.1.0",
    "fs-extra": "^11.2.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.10.2",
    "shx": "^0.3.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
