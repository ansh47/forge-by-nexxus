{{#if lucideReact}}
import { Coffee, Plug, Workflow } from "lucide-react";
{{/if}}
{{#if framerMotion}}
import { motion } from "framer-motion";
{{/if}}
{{#if rtkQuery}}
import { useGetHelloQuery } from "./store/apiSlice";
{{else}}
import { useEffect, useState } from "react";
{{/if}}
import "./App.css";

function App() {
{{#if rtkQuery}}
  // RTK Query handles the request, caching and status flags for us.
  const { data, isLoading, isError } = useGetHelloQuery();
{{else}}
  // Plain fetch against the dev proxy. Scaffold with the RTK Query add-on if
  // you would rather have caching and request status handled for you.
  const [data, setData] = useState<{ message: string; timestamp: string } | null>(null);
  const [isError, setIsError] = useState(false);
  const isLoading = !data && !isError;

  useEffect(() => {
    fetch("/api/hello")
      .then((res) => (res.ok ? res.json() : Promise.reject(new Error(String(res.status)))))
      .then(setData)
      .catch(() => setIsError(true));
  }, []);
{{/if}}

  const wireState = isError ? "wire-error" : data ? "wire-ok" : "wire-loading";

  return (
    <div className="page">
      <header className="topbar">
        <div className="brand">
          <span className="brand-mark" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round">
              <rect x="3" y="4" width="18" height="7" rx="2" />
              <rect x="3" y="13" width="18" height="7" rx="2" />
              <path d="M7 7.5h.01M7 16.5h.01" />
            </svg>
          </span>
          <span>{{projectNameHuman}}</span>
        </div>
        <span className="pill">scaffolded with forge</span>
      </header>

      <main className="main">
        <section className="hero">
          <span className="eyebrow">Wired end to end</span>
          <h1 className="title">{{projectNameHuman}}</h1>
          <p className="lede">
            A Spring Boot API and a React frontend running side by side, with the
            dev proxy already connecting them. The handshake below is live.
          </p>
        </section>

        <section className="link-panel" aria-live="polite">
          <div className="node">
            <span className="node-label">Frontend</span>
            <span className="node-port">Vite :5173</span>
          </div>
          <div className={"wire " + wireState} aria-hidden="true">
            <span className="wire-dot" />
          </div>
          <div className="node node-right">
            <span className="node-label">Backend</span>
            <span className="node-port">Spring Boot :8080</span>
          </div>
        </section>

        <p className="link-status">
          {isLoading && <span>Calling <code>/api/hello</code> through the dev proxy</span>}
          {isError && (
            <span className="status-error">
              No answer from the backend. Start it with <code>mvn spring-boot:run</code> in <code>backend/</code>.
            </span>
          )}
          {data && (
            <span>
              <strong>{data.message}</strong>{" "}
              <span className="stamp">{data.timestamp}</span>
            </span>
          )}
        </p>

        <h2 className="section-title">What is wired up</h2>
        <div className="grid">
          <article className="card">
            <span className="card-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round">
                <rect x="3" y="4" width="18" height="6" rx="2" />
                <rect x="3" y="14" width="18" height="6" rx="2" />
                <path d="M7 7h.01M7 17h.01" />
              </svg>
            </span>
            <h3>Spring Boot</h3>
            <p>
              Controllers live in <code>backend/src/main/java</code>. The example
              endpoint is <code>/api/hello</code>.
            </p>
          </article>

          <article className="card">
            <span className="card-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round">
                <path d="M9 3H5a2 2 0 0 0-2 2v4" />
                <path d="M15 3h4a2 2 0 0 1 2 2v4" />
                <path d="M9 21H5a2 2 0 0 1-2-2v-4" />
                <path d="M15 21h4a2 2 0 0 0 2-2v-4" />
                <circle cx="12" cy="12" r="2.5" />
              </svg>
            </span>
            <h3>Dev proxy</h3>
            <p>
              Vite forwards <code>/api</code> to port 8080, so there is no CORS
              dance while you develop.
            </p>
          </article>

          <article className="card">
            <span className="card-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round">
                <rect x="3" y="3" width="7" height="7" rx="1.5" />
                <rect x="14" y="3" width="7" height="7" rx="1.5" />
                <rect x="3" y="14" width="7" height="7" rx="1.5" />
                <rect x="14" y="14" width="7" height="7" rx="1.5" />
              </svg>
            </span>
            <h3>React and TypeScript</h3>
            <p>
              Strict mode is on. Edit <code>frontend/src/App.tsx</code> and the
              page updates without a reload.
            </p>
          </article>

          <article className="card">
            <span className="card-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round">
                <path d="M4 5h16" />
                <path d="M7 5v6a5 5 0 0 0 10 0V5" />
                <path d="M12 16v3" />
                <path d="M8 21h8" />
              </svg>
            </span>
            <h3>One command</h3>
            <p>
              <code>npm run dev</code> at the root runs both halves together
              using concurrently.
            </p>
          </article>
{{#if framerMotion}}

          <motion.article
            className="card"
            initial={{ opacity: 0, y: 12 }}
            animate={{ opacity: 1, y: 0 }}
            transition={{ delay: 0.5, duration: 0.4 }}
            whileHover={{ y: -6, rotate: -0.6 }}
            whileTap={{ scale: 0.97 }}
          >
            <span className="card-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round">
                <path d="M3 17c4-9 14-9 18 0" />
                <circle cx="7" cy="17" r="2" />
                <circle cx="17" cy="9" r="2" />
              </svg>
            </span>
            <h3>Framer Motion</h3>
            <p>This card animated in, and springs when you hover or press it.</p>
          </motion.article>
{{/if}}
{{#if lucideReact}}

          <article className="card">
            <span className="card-icon" aria-hidden="true">
              <Workflow size={20} />
            </span>
            <h3>Lucide React</h3>
            <p>Tree-shakeable icons imported per component.</p>
            <div className="icon-row" aria-hidden="true">
              <Coffee size={18} />
              <Plug size={18} />
              <Workflow size={18} />
            </div>
          </article>
{{/if}}
{{#if tailwind}}

          <article className="card">
            <span className="card-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round">
                <circle cx="13.5" cy="6.5" r="2.5" />
                <circle cx="19" cy="13" r="2.5" />
                <circle cx="6" cy="12" r="2.5" />
                <path d="M12 22a9 9 0 1 1 0-18c1.5 0 2 1 2 2 0 2-3 2-3 4 0 3 6 1 6 5 0 4-2.5 7-5 7Z" />
              </svg>
            </span>
            <h3>Tailwind CSS</h3>
            <p>Wired through the Vite plugin, no config file needed to start.</p>
            <span className="mt-1 inline-flex w-fit rounded-md bg-teal-100 px-2 py-1 text-xs font-medium text-teal-800 dark:bg-teal-900 dark:text-teal-100">
              Styled with utility classes
            </span>
          </article>
{{/if}}
{{#if rtkQuery}}

          <article className="card">
            <span className="card-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round">
                <ellipse cx="12" cy="5" rx="8" ry="3" />
                <path d="M4 5v14c0 1.7 3.6 3 8 3s8-1.3 8-3V5" />
                <path d="M4 12c0 1.7 3.6 3 8 3s8-1.3 8-3" />
              </svg>
            </span>
            <h3>RTK Query</h3>
            <p>
              The handshake above runs through <code>frontend/src/store/apiSlice.ts</code>,
              pointed at your own backend rather than a placeholder API.
            </p>
          </article>
{{/if}}
        </div>
      </main>

      <footer className="footer">
        <div className="footer-inner">
          <span>Next: add your endpoints in the backend, then call them from here.</span>
          <a href="https://github.com/ansh47/forge-by-nexxus" target="_blank" rel="noreferrer">
            forge by nexxus
          </a>
        </div>
      </footer>
    </div>
  );
}

export default App;
